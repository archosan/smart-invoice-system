<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.archosan.invoice</groupId>
        <artifactId>invoice-system</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>compliance-service</artifactId>
    <name>compliance-service</name>
    <description>Fatura-sözleşme uyum kontrolü ve sözleşme indeksleme</description>

    <dependencies>
        <dependency>
            <groupId>com.archosan.invoice</groupId>
            <artifactId>common-messaging</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- /actuator/prometheus (B-48, NFR-06); sürüm Boot'tan -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- Sözleşme API'sinin yetkisi, document-service ile aynı yöntem (B-45, ADR-22). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- sem:llm (ADR-07): değer çıkarımı extraction ile aynı LLM semaforunu paylaşır (B-46) -->
        <dependency>
            <groupId>com.archosan.invoice</groupId>
            <artifactId>llm-support</artifactId>
        </dependency>
        <!-- bge-m3 embedding (B-45) ve maddeden değer çıkarımı (B-46), ADR-12 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-ollama</artifactId>
        </dependency>

        <!-- compliance_db: outbox ve inbox (ADR-20), sözleşmeler ve chunk'lar (B-45) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Sözleşme PDF'leri: B-44'te sentetik set üretimi, B-45'te metin çıkarımı (sürüm kök pom'da). -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.archosan.invoice</groupId>
            <artifactId>test-support</artifactId>
        </dependency>
        <!-- B-16 fatura kataloğu ve DejaVu Sans (test-jar). Sözleşmeler bu faturaların tedarikçilerine yazılır (B-44).
             Geçişli bağımlılıklar dışlanır: extraction-service'in Spring AI'ı bu modülün testlerine girmesin. -->
        <dependency>
            <groupId>com.archosan.invoice</groupId>
            <artifactId>extraction-service</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Test-jar da üretildiği için (B-46) çalıştırılabilir jar ayrı adla: compliance-service-*-exec.jar -->
                    <classifier>exec</classifier>
                </configuration>
            </plugin>
            <!-- system-tests sözleşme kataloğunu, üreticiyi ve iyi LLM yanıtlayıcısını kullanır (B-46) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
