<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.archosan.invoice</groupId>
        <artifactId>invoice-system</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>extraction-service</artifactId>
    <name>extraction-service</name>
    <description>PDF'ten yapılandırılmış fatura verisi ve güven skoru</description>

    <dependencies>
        <dependency>
            <groupId>com.archosan.invoice</groupId>
            <artifactId>common-messaging</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- /actuator/prometheus (B-48, NFR-06); sürüm Boot'tan -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- Ham LLM çıktısı API'sinin yetkisi (B-47, ADR-22) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- Metin çıkarımı (B-17, FR-E1) ve test setinin üreticisi (B-16) -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
        </dependency>

        <!-- LLM (B-18, ADR-12) -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-ollama</artifactId>
        </dependency>
        <!-- sem:llm (ADR-07, B-46'dan beri ortak modülde); RedissonClient spring.data.redis.* ayarlarından kurulur -->
        <dependency>
            <groupId>com.archosan.invoice</groupId>
            <artifactId>llm-support</artifactId>
        </dependency>

        <!-- extraction_db: outbox ve inbox (ADR-20) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.archosan.invoice</groupId>
            <artifactId>test-support</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Düz jar ana artefakt kalır ki system-tests B-16 setini (LlmInvoice dahil) kullanabilsin (B-28);
                         çalıştırılabilir jar extraction-service-*-exec.jar -->
                    <classifier>exec</classifier>
                </configuration>
            </plugin>
            <!-- Sahte Ollama ve B-16 seti (test sınıfları, PDF'ler) system-tests ile paylaşılır (B-28) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
