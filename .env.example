# Kopyala: cp .env.example .env  — gerçek .env git'e girmez (NFR-10).
# Tüm "change-me" değerlerini değiştir.

# --- PostgreSQL (B-02) ---
# Superuser; yalnızca init script'i ve yönetim için.
POSTGRES_ADMIN_PASSWORD=change-me
# Servis kullanıcıları: document_user, extraction_user, compliance_user, rpa_user
DOCUMENT_DB_PASSWORD=change-me
EXTRACTION_DB_PASSWORD=change-me
COMPLIANCE_DB_PASSWORD=change-me
RPA_DB_PASSWORD=change-me

# --- RabbitMQ (B-03) ---
# Uygulama kullanıcısı açılışta infra/rabbitmq/init-user.sh ile üretilir (vhost: invoice).
# Kullanıcı adı: harf, rakam, . _ -
RABBITMQ_USERNAME=invoice
RABBITMQ_PASSWORD=change-me
# İsteğe bağlı: yönetim arayüzü (http://localhost:15672) için ayrı insan kullanıcısı; "monitoring" etiketi,
# invoice vhost'unda yalnız okuma (yayınlayamaz; okuma izni mesaj almayı ve kuyruk boşaltmayı kapsar).
# Arayüz yalnız bu makineden açılır. Şifre boş ya da satır yoksa kullanıcı üretilmez, arayüze kimse giremez.
RABBITMQ_ADMIN_USERNAME=rabbit-admin
RABBITMQ_ADMIN_PASSWORD=change-me

# --- Mock portal kimlik bilgileri (B-24, B-26) ---
PORTAL_USERNAME=rpa-bot
PORTAL_PASSWORD=change-me
# Testler için hata bayrağı (B-24): fatura numarası bu düzenli ifadeyle eşleşen form her gönderildiğinde 500 döner.
# Kullanılmıyorsa satır yorumda kalsın.
# PORTAL_FAIL_INVOICE_NO_PATTERN=^FAIL-
# Testler için (B-35): eşleşen gönderim kaydedilir ama yanıt 20 sn gecikir (bot bu arada öldürülebilir).
# PORTAL_SLOW_INVOICE_NO_PATTERN=^SLOW-
# Hata enjeksiyonu (FR-P3, B-36): oturum boşta kalma süresi, her sayfada 500 olasılığı (0-1) ve tohumu,
# fatura formu ile sonuç tablosunun gecikmesi.
# PORTAL_SESSION_IDLE_TIMEOUT=2m
# PORTAL_ERROR_RATE=0.1
# PORTAL_ERROR_SEED=42
# PORTAL_ELEMENT_DELAY=3s

# --- document-service API kullanıcıları (B-43) ---
# HTTP Basic; kullanıcı adları application.yml'de: expert (EXPERT), approver (APPROVER), admin (ADMIN),
# expert-approver (EXPERT + APPROVER; "onaycı kendi yüklediğini onaylayamaz" kuralını göstermek için).
API_EXPERT_PASSWORD=change-me
API_APPROVER_PASSWORD=change-me
API_ADMIN_PASSWORD=change-me
API_EXPERT_APPROVER_PASSWORD=change-me

# --- Ollama modelleri (B-18) ---
# Sohbet modeli (7-8B, 4-bit; B-18). Host'ta önceden çekilmeli: ollama pull qwen2.5:7b-instruct
OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBEDDING_MODEL=bge-m3
